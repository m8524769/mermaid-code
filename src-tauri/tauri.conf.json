{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mermaid Code",
  "version": "0.3.10",
  "identifier": "com.m8524769.mermaid-code",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mermaid Code",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "./Info.plist"
    },
    "fileAssociations": [
      {
        "ext": ["mmd", "mermaid"],
        "name": "Mermaid Diagram",
        "description": "Mermaid Diagram File",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGMzdDMzE3Rjk5RTFEMEMKUldRTUhaNzVGOE0zMzgxZEhGYWNZOWplZGRkT1doUU1XK2xSWWtub2ZaT2dub0Ezd0oxc0o5TWkK",
      "endpoints": [
        "https://github.com/m8524769/mermaid-code/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
