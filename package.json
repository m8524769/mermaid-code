    "@iconify-json/fa7-solid": "^1.2.5",
    "@iconify-json/logos": "^1.2.21",
    "@iconify-json/material-symbols": "^1.2.101",
    "@inlang/paraglide-js": "^2.25.2",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.1",
    "@sveltejs/load-config": "^0.2.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/hammerjs": "^2.0.46",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.2",
    "@vitest/ui": "^5.1.2",
    "bits-ui": "^2.22.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "paneforge": "1.0.2",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "svelte-sonner": "^1.2.3",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.4.0",
    "vite-plugin-devtools-json": "^1.1.2",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "@fontsource-variable/recursive": "^5.3.0",
    "@mermaid-js/examples": "^2.1.0",
    "@mermaid-js/layout-tidy-tree": "^1.0.1",
    "@mermanjs/tree-sitter-mermaid": "^0.3.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "dompurify": "^3.5.0",
    "hammerjs": "^2.0.10",
    "js-base64": "3.9.7",
    "lodash-es": "^4.18.1",
    "marked": "^18.3.0",
    "mermaid": "^12.4.0",
    "mode-watcher": "^1.1.0",
    "monaco-editor": "0.58.0",
    "monaco-vim": "^0.4.4",
    "pako": "3.0.3",
    "shiki": "^4.6.0",
    "svg-pan-zoom": "3.6.2",
    "svg2roughjs": "^3.2.3",
    "uuid": "14.0.2",
    "virtua": "^0.56.0",
    "web-tree-sitter": "^0.27.2"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "lint-staged": {
    "*.{ts,svelte,js,css,md,json}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.22.3"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
