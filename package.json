{
  "name": "mermaid-code",
  "version": "0.9.6",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "dev:force": "vite dev --force",
    "build": "vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:mcp": "bash scripts/build-mcp.sh",
    "tauri:build:full": "bash scripts/build-mcp.sh && tauri build",
    "gen:icon-index": "bun run scripts/gen-icon-index.ts",
    "release": "sh scripts/release.sh",
    "build:changelog": "node scripts/build-changelog.mjs",
    "preview:site": "node scripts/preview-site.mjs",
    "stats:downloads": "node --env-file-if-exists=.env.local scripts/download-stats.mjs --open",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check --cache . && eslint .",
    "format": "prettier --write --cache .",
    "postinstall": "husky && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations && svelte-kit sync",
    "test:unit": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest run --coverage",
    "test": "pnpm test:unit run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@iconify-json/fa7-brands": "^1.2.4",
