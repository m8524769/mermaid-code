    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/hammerjs": "^2.0.46",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^5.0.2",
